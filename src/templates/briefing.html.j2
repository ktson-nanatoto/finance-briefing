<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>재테크 모닝 브리핑 — {{ date }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #f4f6f9;
      --card-bg: #ffffff;
      --text: #1a1a2e;
      --text-sub: #555577;
      --border: #e2e8f0;
      --shadow: 0 2px 12px rgba(0,0,0,0.07);
      --up-text: #3B6D11;
      --up-bg: #EAF3DE;
      --down-text: #A32D2D;
      --down-bg: #FCEBEB;
      --insight-bg: #E6F1FB;
      --insight-text: #0C447C;
      --badge-open: #EAF3DE;
      --badge-open-text: #3B6D11;
      --badge-close: #f0f0f0;
      --badge-close-text: #555577;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0f1117;
        --card-bg: #1e2130;
        --text: #e8eaf0;
        --text-sub: #9099b0;
        --border: #2d3250;
        --shadow: 0 2px 12px rgba(0,0,0,0.3);
        --up-text: #7dba3f;
        --up-bg: #1c2e10;
        --down-text: #e06060;
        --down-bg: #2e1010;
        --insight-bg: #0d1e35;
        --insight-text: #80b8f0;
        --badge-open: #1c2e10;
        --badge-open-text: #7dba3f;
        --badge-close: #252535;
        --badge-close-text: #9099b0;
      }
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Noto Sans KR', sans-serif;
      background: var(--bg);
      color: var(--text);
      padding: 16px;
    }
    .wrap { max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
    .card {
      background: var(--card-bg);
      border-radius: 12px;
      box-shadow: var(--shadow);
      padding: 16px;
      border: 1px solid var(--border);
    }
    .card-title {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-sub);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 10px;
    }

    /* 헤더 */
    .header { text-align: center; }
    .header .date { font-size: 13px; color: var(--text-sub); margin-bottom: 6px; }
    .header .title { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
    }
    .badge-open { background: var(--badge-open); color: var(--badge-open-text); }
    .badge-close { background: var(--badge-close); color: var(--badge-close-text); }

    /* 핵심 이슈 */
    .headline { font-size: 15px; font-weight: 700; line-height: 1.5; margin-bottom: 10px; }
    .issue-list { list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .issue-list li {
      font-size: 13px;
      line-height: 1.5;
      padding-left: 14px;
      position: relative;
      color: var(--text-sub);
    }
    .issue-list li::before { content: "•"; position: absolute; left: 0; color: var(--insight-text); }

    /* 지표 그리드 */
    .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .metric-item { padding: 10px; border-radius: 8px; background: var(--bg); }
    .metric-label { font-size: 11px; color: var(--text-sub); margin-bottom: 4px; }
    .metric-value { font-size: 16px; font-weight: 700; }
    .metric-change { font-size: 12px; margin-top: 2px; }
    .up { color: var(--up-text); }
    .down { color: var(--down-text); }
    .neutral { color: var(--text-sub); }

    /* 2단 레이아웃 */
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .two-col .card { margin: 0; }

    /* 뉴스 목록 */
    .news-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
    .news-list li { font-size: 13px; line-height: 1.5; }
    .news-source {
      display: inline-block;
      font-size: 10px;
      font-weight: 700;
      padding: 1px 6px;
      border-radius: 4px;
      background: var(--insight-bg);
      color: var(--insight-text);
      margin-bottom: 2px;
    }

    /* 인사이트 */
    .insight-card { background: var(--insight-bg); border-color: transparent; }
    .insight-card .card-title { color: var(--insight-text); }
    .insight-text { font-size: 14px; line-height: 1.7; color: var(--insight-text); margin-bottom: 10px; }
    .risk-label { font-size: 11px; font-weight: 700; color: var(--down-text); margin-bottom: 4px; }
    .risk-text { font-size: 13px; color: var(--text-sub); line-height: 1.5; }

    /* 경고 배너 */
    .warning-banner {
      background: #fff8e1;
      border: 1px solid #ffe082;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 12px;
      color: #7a5c00;
    }

    /* 면책 문구 */
    .disclaimer { font-size: 11px; color: var(--text-sub); text-align: center; line-height: 1.6; padding: 8px 0; }

    /* QR */
    .qr-wrap { text-align: center; padding: 8px 0; }
    .qr-wrap img { width: 80px; height: 80px; }
    .qr-label { font-size: 11px; color: var(--text-sub); margin-top: 4px; }
  </style>
</head>
<body>
<div class="wrap">

  <!-- 1. 헤더 -->
  <div class="card header">
    <div class="date">{{ date }}</div>
    <div class="title">재테크 모닝 브리핑</div>
    <span class="badge {% if analysis.market_status == '장중' %}badge-open{% else %}badge-close{% endif %}">
      {{ analysis.market_status }}
    </span>
  </div>

  {% if warnings %}
  <!-- 데이터 수집 경고 배너 -->
  <div class="warning-banner">
    ⚠️ 일부 데이터 수집에 문제가 있습니다. 수치를 직접 확인해 주세요.<br>
    {% for w in warnings %}<small>{{ w }}</small><br>{% endfor %}
  </div>
  {% endif %}

  <!-- 2. 핵심 이슈 -->
  <div class="card">
    <div class="card-title">오늘의 핵심 이슈</div>
    <div class="headline">{{ analysis.headline }}</div>
    <ul class="issue-list">
      {% for issue in analysis.key_issues %}
      <li>{{ issue }}</li>
      {% endfor %}
    </ul>
  </div>

  <!-- 3. 핵심 지표 -->
  <div class="card">
    <div class="card-title">핵심 지표</div>
    <div class="metrics-grid">
      {% if data.kr_market.usd_krw and not data.kr_market.usd_krw.error is defined %}
      <div class="metric-item">
        <div class="metric-label">USD/KRW</div>
        <div class="metric-value">{{ data.kr_market.usd_krw.price | round(1) }}원</div>
        <div class="metric-change {% if data.kr_market.usd_krw.change > 0 %}up{% elif data.kr_market.usd_krw.change < 0 %}down{% else %}neutral{% endif %}">
          {% if data.kr_market.usd_krw.change > 0 %}▲{% elif data.kr_market.usd_krw.change < 0 %}▼{% endif %}
          {{ data.kr_market.usd_krw.change | abs | round(1) }} ({{ data.kr_market.usd_krw.change_pct | abs | round(2) }}%)
        </div>
      </div>
      {% endif %}

      {% if data.kr_market.oil_wti and not data.kr_market.oil_wti.error is defined %}
      <div class="metric-item">
        <div class="metric-label">WTI 원유</div>
        <div class="metric-value">${{ data.kr_market.oil_wti.price }}</div>
        <div class="metric-change {% if data.kr_market.oil_wti.change > 0 %}up{% elif data.kr_market.oil_wti.change < 0 %}down{% else %}neutral{% endif %}">
          {% if data.kr_market.oil_wti.change > 0 %}▲{% elif data.kr_market.oil_wti.change < 0 %}▼{% endif %}
          {{ data.kr_market.oil_wti.change | abs }} ({{ data.kr_market.oil_wti.change_pct | abs }}%)
        </div>
      </div>
      {% endif %}

      {% if data.kr_market.gold and not data.kr_market.gold.error is defined %}
      <div class="metric-item">
        <div class="metric-label">금</div>
        <div class="metric-value">${{ data.kr_market.gold.price }}</div>
        <div class="metric-change {% if data.kr_market.gold.change > 0 %}up{% elif data.kr_market.gold.change < 0 %}down{% else %}neutral{% endif %}">
          {% if data.kr_market.gold.change > 0 %}▲{% elif data.kr_market.gold.change < 0 %}▼{% endif %}
          {{ data.kr_market.gold.change | abs }} ({{ data.kr_market.gold.change_pct | abs }}%)
        </div>
      </div>
      {% endif %}

      {% if data.kr_market.jpy_krw and not data.kr_market.jpy_krw.error is defined %}
      <div class="metric-item">
        <div class="metric-label">JPY/KRW (100엔)</div>
        <div class="metric-value">{{ data.kr_market.jpy_krw.price | round(1) }}원</div>
        <div class="metric-change {% if data.kr_market.jpy_krw.change > 0 %}up{% elif data.kr_market.jpy_krw.change < 0 %}down{% else %}neutral{% endif %}">
          {% if data.kr_market.jpy_krw.change > 0 %}▲{% elif data.kr_market.jpy_krw.change < 0 %}▼{% endif %}
          {{ data.kr_market.jpy_krw.change | abs | round(1) }} ({{ data.kr_market.jpy_krw.change_pct | abs | round(2) }}%)
        </div>
      </div>
      {% endif %}
    </div>
  </div>

  <!-- 4. 미국 증시 + 한국 증시 -->
  <div class="two-col">
    <div class="card">
      <div class="card-title">미국 증시</div>
      {% for key, label in [('sp500','S&P 500'),('nasdaq','NASDAQ'),('dow','DOW'),('vix','VIX')] %}
      {% set item = data.us_market[key] %}
      {% if item and item.error is not defined %}
      <div style="margin-bottom:8px">
        <div class="metric-label">{{ label }}</div>
        <div class="metric-value" style="font-size:14px">{{ item.price | round(2) }}</div>
        <div class="metric-change {% if item.change > 0 %}up{% elif item.change < 0 %}down{% else %}neutral{% endif %}" style="font-size:11px">
          {% if item.change > 0 %}▲{% elif item.change < 0 %}▼{% endif %}
          {{ item.change_pct | abs | round(2) }}%
        </div>
      </div>
      {% endif %}
      {% endfor %}
      {% if analysis.us_market_comment %}
      <div style="font-size:12px; color:var(--text-sub); margin-top:8px; line-height:1.5">{{ analysis.us_market_comment }}</div>
      {% endif %}
    </div>

    <div class="card">
      <div class="card-title">한국 증시</div>
      {% for key, label in [('kospi','KOSPI'),('kosdaq','KOSDAQ')] %}
      {% set item = data.kr_market[key] %}
      {% if item and item.error is not defined %}
      <div style="margin-bottom:8px">
        <div class="metric-label">{{ label }}</div>
        <div class="metric-value" style="font-size:14px">{{ item.price | round(2) }}</div>
        <div class="metric-change {% if item.change > 0 %}up{% elif item.change < 0 %}down{% else %}neutral{% endif %}" style="font-size:11px">
          {% if item.change > 0 %}▲{% elif item.change < 0 %}▼{% endif %}
          {{ item.change_pct | abs | round(2) }}%
        </div>
      </div>
      {% endif %}
      {% endfor %}
      {% if analysis.kr_market_comment %}
      <div style="font-size:12px; color:var(--text-sub); margin-top:8px; line-height:1.5">{{ analysis.kr_market_comment }}</div>
      {% endif %}
    </div>
  </div>

  <!-- 5. 금리 동향 + 부동산 -->
  <div class="two-col">
    <div class="card">
      <div class="card-title">금리 동향</div>
      {% if data.macro.us_fed_rate and data.macro.us_fed_rate.error is not defined %}
      <div style="margin-bottom:8px">
        <div class="metric-label">미국 기준금리</div>
        <div class="metric-value" style="font-size:14px">{{ data.macro.us_fed_rate.value }}%</div>
        <div class="metric-label">{{ data.macro.us_fed_rate.date }}</div>
      </div>
      {% endif %}
      {% if data.macro.us_10y_yield and data.macro.us_10y_yield.error is not defined %}
      <div style="margin-bottom:8px">
        <div class="metric-label">미국 10년 국채</div>
        <div class="metric-value" style="font-size:14px">{{ data.macro.us_10y_yield.value }}%</div>
      </div>
      {% endif %}
      {% if data.macro.kr_base_rate and data.macro.kr_base_rate.error is not defined %}
      <div style="margin-bottom:8px">
        <div class="metric-label">한국 기준금리</div>
        <div class="metric-value" style="font-size:14px">{{ data.macro.kr_base_rate.value }}%</div>
      </div>
      {% endif %}
      {% if analysis.macro_comment %}
      <div style="font-size:12px; color:var(--text-sub); margin-top:8px; line-height:1.5">{{ analysis.macro_comment }}</div>
      {% endif %}
    </div>

    {% if data.realestate.articles %}
    <div class="card">
      <div class="card-title">부동산</div>
      {% if analysis.realestate_comment %}
      <div style="font-size:12px; color:var(--text-sub); margin-bottom:8px; line-height:1.5">{{ analysis.realestate_comment }}</div>
      {% endif %}
      <ul class="news-list">
        {% for article in data.realestate.articles[:3] %}
        <li>{{ article.title }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>

  <!-- 6. 주요 뉴스 -->
  {% if data.news.kr_news or data.news.us_news %}
  <div class="card">
    <div class="card-title">주요 뉴스</div>
    <ul class="news-list">
      {% for article in data.news.kr_news[:3] %}
      {% if article.title %}
      <li>
        <span class="news-source">국내</span>
        {{ article.title }}
      </li>
      {% endif %}
      {% endfor %}
      {% for article in data.news.us_news[:4] %}
      {% if article.title %}
      <li>
        <span class="news-source">{{ article.source }}</span>
        {{ article.title }}
      </li>
      {% endif %}
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <!-- 7. 인사이트 -->
  <div class="card insight-card">
    <div class="card-title">오늘의 인사이트</div>
    <div class="insight-text">{{ analysis.insight }}</div>
    {% if analysis.risk %}
    <div class="risk-label">⚠ 주요 리스크</div>
    <div class="risk-text">{{ analysis.risk }}</div>
    {% endif %}
  </div>

  <!-- QR 코드 -->
  {% if qr_base64 %}
  <div class="card qr-wrap">
    <img src="data:image/png;base64,{{ qr_base64 }}" alt="브리핑 QR코드" />
    <div class="qr-label">카카오톡 오픈채팅 공유용 QR</div>
  </div>
  {% endif %}

  <!-- 8. 면책 문구 -->
  <div class="disclaimer">
    본 브리핑은 투자 참고 자료이며 투자 권유가 아닙니다.<br>
    투자 손실에 대한 책임은 투자자 본인에게 있습니다.<br>
    <small>Generated {{ date }} · finance-briefing</small>
  </div>

</div>
</body>
</html>
